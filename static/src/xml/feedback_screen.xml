<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_feedback_bypass.FeedbackScreen"
       t-inherit="point_of_sale.FeedbackScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('feedback-screen')]" position="attributes">
            <attribute name="t-att-data-hide-all-buttons">this.hideAllButtonsAttr</attribute>
            <attribute name="t-att-data-hide-print-btn">this.hidePrintBtnAttr</attribute>
            <attribute name="t-att-data-hide-send-btn">this.hideSendBtnAttr</attribute>
            <attribute name="t-att-data-hide-edit-btn">this.hideEditBtnAttr</attribute>
            <attribute name="t-att-data-has-details">this.hasDetailsCardAttr</attribute>
        </xpath>

        <xpath expr="//FeedbackPaymentSummary" position="after">
            <div t-if="this.fbConfig.iface_feedback_show_details"
                 class="o_feedback_details_wrapper w-100 d-flex justify-content-center px-3 my-3">
                <t t-set="details" t-value="this.feedbackOrderDetails"/>
                <div class="o_feedback_details_card d-flex flex-wrap align-items-stretch justify-content-center shadow-sm">
                    <div t-if="this.fbConfig.iface_feedback_show_total"
                         class="o_feedback_stat">
                        <span class="o_feedback_stat_label">Total</span>
                        <span class="o_feedback_stat_value text-dark" t-out="details.total"/>
                    </div>

                    <t t-if="this.fbConfig.iface_feedback_show_cash">
                        <t t-if="details.paymentLines.length > 0">
                            <t t-foreach="details.paymentLines" t-as="pm" t-key="pm.id">
                                <div class="o_feedback_stat">
                                    <span class="o_feedback_stat_label" t-out="pm.name"/>
                                    <span class="o_feedback_stat_value text-primary" t-out="pm.formattedAmount"/>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="o_feedback_stat">
                                <span class="o_feedback_stat_label">Cash / Paid</span>
                                <span class="o_feedback_stat_value text-primary" t-out="details.cashPaid"/>
                            </div>
                        </t>
                    </t>

                    <div t-if="this.fbConfig.iface_feedback_show_change"
                         t-att-class="'o_feedback_stat ' + (details.hasChange ? 'o_feedback_stat_change' : '')">
                        <span class="o_feedback_stat_label">Change</span>
                        <span t-att-class="'o_feedback_stat_value ' + (details.hasChange ? 'text-success' : 'text-secondary')"
                              t-out="details.change"/>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
